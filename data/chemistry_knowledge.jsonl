{"type": "law", "name": "multiple_proportions", "statement": "Elements combine in ratios of small whole numbers", "domain": "stoichiometry"}
{"type": "law", "name": "ideal_gas", "statement": "PV = nRT for ideal gases", "formula": "PV = nRT"}
{"type": "law", "name": "henrys_law", "statement": "Gas solubility proportional to partial pressure", "formula": "C = k_H * P"}
{"type": "law", "name": "raoults_law", "statement": "Vapor pressure of solution proportional to mole fraction", "formula": "P_solution = X_solvent * P°_solvent"}
{"type": "concept", "name": "mole", "definition": "6.022×10^23 entities (Avogadro's number)", "domain": "stoichiometry"}
{"type": "concept", "name": "molarity", "definition": "Moles of solute per liter of solution", "formula": "M = moles/volume(L)"}
{"type": "concept", "name": "ph", "definition": "Negative log of hydrogen ion concentration", "formula": "pH = -log[H+]"}
{"type": "concept", "name": "oxidation_state", "definition": "Charge atom would have if bonds were ionic", "domain": "redox"}
{"type": "concept", "name": "activation_energy", "definition": "Minimum energy for reaction to occur", "domain": "kinetics"}
{"type": "concept", "name": "catalyst", "definition": "Substance increasing reaction rate without being consumed", "domain": "kinetics"}
{"type": "concept", "name": "equilibrium_constant", "definition": "Ratio of product to reactant concentrations at equilibrium", "formula": "K = [products]/[reactants]"}
{"type": "concept", "name": "le_chatelier", "definition": "System at equilibrium shifts to counteract applied stress", "domain": "equilibrium"}
{"type": "concept", "name": "electronegativity", "definition": "Atom's ability to attract electrons in bond", "domain": "bonding"}
